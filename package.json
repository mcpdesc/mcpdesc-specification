{
  "name": "@mcpdesc/specification",
  "version": "0.0.0-private",
  "private": true,
  "description": "Development and validation tooling for the MCP Description specification",
  "type": "module",
  "scripts": {
    "test": "node scripts/test-serializations.mjs && node scripts/test-schema-publication.mjs && node scripts/validate-repository.mjs && node scripts/test-views.mjs",
    "test:publication": "node scripts/test-schema-publication.mjs",
    "validate": "node scripts/validate-repository.mjs",
    "assemble:draft": "node scripts/assemble-draft.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:check:draft-publication": "node scripts/check-release.mjs draft-publication",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "uri-template-matcher": "^1.1.2",
    "yaml": "^2.9.0"
  },
  "license": "Apache-2.0"
}
