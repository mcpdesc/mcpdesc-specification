{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpdesc.org/schema/validation-result/1.4.0.json",
  "title": "MCP Description validation result",
  "description": "Validation result format 1.4.0 (Proposal 0035): document validity, diagnostics with factual detail and related locations, and optional rule results with one status per rule and declared MCP protocol version. Producers may add properties to the result and to diagnostics; rule results are closed.",
  "type": "object",
  "required": [
    "valid",
    "diagnostics"
  ],
  "properties": {
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "type": "array"
    },
    "results": {
      "description": "Rule results. Optional, but required of a validator that claims conformance with the specification's validation fixtures.",
      "items": {
        "$ref": "#/$defs/rule-result"
      },
      "type": "array"
    },
    "valid": {
      "description": "True when no diagnostic has severity error. Rule results do not change validity.",
      "type": "boolean"
    }
  },
  "$defs": {
    "diagnostic": {
      "description": "A finding of a check that ran. rule, severity, and path are the interoperable contract; code and message belong to the producer. Schema-derived findings in format 1.4.0 include detail.",
      "properties": {
        "code": {
          "description": "Producer-defined category. Not defined by this specification; several rules can share one code.",
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/detail"
        },
        "message": {
          "description": "Informative text for readers.",
          "type": "string"
        },
        "path": {
          "description": "Location in the validated document, as property names and array indexes from the document root.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ]
          },
          "type": "array"
        },
        "relatedLocations": {
          "items": {
            "$ref": "#/$defs/related-location"
          },
          "type": "array"
        },
        "protocolVersions": {
          "description": "MCP protocol versions the finding concerns, when it depends on the version.",
          "items": {
            "$ref": "#/$defs/protocol-version"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "rule": {
          "$ref": "#/$defs/rule-id"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        }
      },
      "required": [
        "rule",
        "severity",
        "path"
      ],
      "type": "object"
    },
    "detail": {
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "missing-member"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "member": true
            },
            "required": [
              "member"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unexpected-member"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "allowedMembers": true,
              "member": true
            },
            "required": [
              "member",
              "allowedMembers"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "invalid-member-name"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "member": true
            },
            "required": [
              "member"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "invalid-value"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "allowedValues": true
            },
            "required": [
              "allowedValues"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "invalid-type"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "expectedTypes": true
            },
            "required": [
              "expectedTypes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "conflicting-members"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "members": true
            },
            "required": [
              "members"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "missing-alternative"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "members": true
            },
            "required": [
              "members"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "constraint"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "keyword": true
            },
            "required": [
              "keyword"
            ]
          }
        }
      ],
      "description": "Factual detail for a diagnostic. kind is extensible; consumers should fall back to message for kinds they do not recognize.",
      "properties": {
        "allowedMemberPatterns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowedMembers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowedValues": {
          "items": {},
          "type": "array"
        },
        "expectedTypes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "keyword": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "member": {
          "type": "string"
        },
        "members": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "selector": {
          "properties": {
            "member": {
              "type": "string"
            },
            "value": {}
          },
          "required": [
            "member",
            "value"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "protocol-version": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "related-location": {
      "properties": {
        "path": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ]
          },
          "type": "array"
        },
        "relation": {
          "const": "component-definition"
        }
      },
      "required": [
        "path",
        "relation"
      ],
      "type": "object"
    },
    "rule-id": {
      "description": "Identifier of a rule in the validation rule catalog.",
      "pattern": "^(mcp|mcpdesc|json-schema)(\\.[a-z0-9]+(-[a-z0-9]+)*)+$",
      "type": "string"
    },
    "rule-result": {
      "additionalProperties": false,
      "dependentSchemas": {
        "reason": {
          "properties": {
            "status": {
              "const": "not-evaluated"
            }
          }
        }
      },
      "description": "The status of one rule for one declared MCP protocol version, or for the document when the rule's applicability is independent. A status comes from checks the validator executed: passed is never inferred from the absence of diagnostics.",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/protocol-version"
        },
        "reason": {
          "description": "Why a check was not evaluated; only with status not-evaluated, and optional. earlier-stage-failed: an earlier validation stage failed. not-implemented: the validator does not implement the check. operation: another operation, such as projection or merge, checks the requirement.",
          "enum": [
            "earlier-stage-failed",
            "not-implemented",
            "operation"
          ]
        },
        "rule": {
          "$ref": "#/$defs/rule-id"
        },
        "status": {
          "description": "passed: the check ran and found nothing. failed: it reported at least one error. warning: it reported warnings but no error. not-applicable: the rule does not apply to that version, or the document contains nothing it checks. not-evaluated: the check applies but did not run. delegated: another operation, such as native projection, performs the check.",
          "enum": [
            "passed",
            "failed",
            "warning",
            "not-applicable",
            "not-evaluated",
            "delegated"
          ]
        }
      },
      "required": [
        "rule",
        "status"
      ],
      "type": "object"
    }
  }
}
