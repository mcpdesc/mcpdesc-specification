{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Description validation rule registry file",
  "description": "Structure of each YAML file under validation/rules/. See Proposal 0024 and validation/README.md.",
  "type": "object",
  "required": [
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "summary",
        "surface",
        "kind",
        "specification",
        "diagnostics",
        "enforcement",
        "status",
        "fixtures"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(mcp|mcpdesc|json-schema)(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
        },
        "owner": {
          "enum": [
            "mcp",
            "mcpdesc",
            "json-schema"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "structural",
            "semantic",
            "preservation",
            "embedded-standard",
            "mcpdesc-semantic",
            "completeness",
            "interoperability"
          ]
        },
        "requirement": {
          "enum": [
            "must",
            "should",
            "may"
          ]
        },
        "applicability": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/revision"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          }
        },
        "specification": {
          "description": "The MCP Description requirements the rule checks, and the decisions behind it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "reference",
              "locations"
            ],
            "additionalProperties": false,
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "locations": {
                "description": "Locations relative to the specification folder: a requirement anchor in a section, a Markdown heading under validation/, a proposal snapshot, or a released proposal.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(sections/[0-9]{2}-[a-z-]+\\.md#req-[a-z0-9-]+|validation/[A-Za-z0-9-]+\\.md#[a-z0-9-]+|proposal-snapshots/[0-9]{4}-[a-z0-9-]+\\.md|\\.\\./\\.\\./proposals/[0-9]{4}-[a-z0-9-]+\\.md)$"
                }
              }
            }
          }
        },
        "sources": {
          "description": "External evidence for the rule, by authority tier.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "tier",
              "reference",
              "locations"
            ],
            "additionalProperties": false,
            "properties": {
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "locations": {
                "description": "Precise, immutable locations: a vendored MCP schema line range, relative to the specification folder, or an HTTPS URL.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(validation/mcp-schemas/[0-9]{4}-[0-9]{2}-[0-9]{2}/schema\\.(ts|json)#L[0-9]+(-L[0-9]+)?|https://[^\\s]+)$"
                }
              }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "severity"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              }
            }
          }
        },
        "enforcement": {
          "enum": [
            "internal",
            "official-schema",
            "external"
          ]
        },
        "status": {
          "enum": [
            "internal",
            "externally-verified",
            "delegated",
            "arbitrated",
            "retired"
          ]
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "path",
              "pointer"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^expected-(valid|invalid|warning)/[a-z0-9-]+\\.(json|ya?ml)$"
              },
              "pointer": {
                "description": "JSON Pointer to the fragment that illustrates the rule; the empty string selects the whole document.",
                "type": "string",
                "pattern": "^(/([^~/]|~[01])*)*$"
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "behavior",
              "resolution"
            ],
            "additionalProperties": false,
            "properties": {
              "revisions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/revision"
                }
              },
              "behavior": {
                "type": "string",
                "minLength": 1
              },
              "resolution": {
                "enum": [
                  "not-fixed",
                  "planned"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "arbitrations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "revisions",
              "conflict",
              "authority",
              "behavior",
              "rationale",
              "reviewTrigger",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "revisions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/revision"
                }
              },
              "conflict": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "behavior": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "upstream": {
                "type": "string",
                "minLength": 1
              },
              "reviewTrigger": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "active",
                  "proposed",
                  "retired"
                ]
              }
            }
          }
        }
      }
    }
  }
}
