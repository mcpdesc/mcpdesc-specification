{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Description conversion rules",
  "description": "Conversion rules from one MCP Description version to the next (Proposal 0028). Non-normative tooling profile.",
  "type": "object",
  "required": [
    "from",
    "to",
    "sourceSelector",
    "rewrites",
    "rules",
    "fixes"
  ],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "$ref": "#/$defs/version"
    },
    "to": {
      "$ref": "#/$defs/version"
    },
    "sourceSelector": {
      "description": "Validator selector used to validate source documents.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z]+\\.[0-9]+)?$"
    },
    "rewrites": {
      "description": "Automatic rewrites, applied in order. Each preserves meaning.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/pointer"
          },
          "value": true,
          "valueFrom": {
            "description": "target-schema-id: the $id of the target version's schema.",
            "enum": [
              "target-schema-id"
            ]
          },
          "ifPresent": {
            "description": "Rewrite only when the member exists in the source.",
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "value"
            ]
          },
          {
            "required": [
              "valueFrom"
            ]
          }
        ]
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "targetRules",
          "fixes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^mcpdesc\\.conversion\\.[0-9]+-[0-9]+-to-[0-9]+-[0-9]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "targetRules": {
            "description": "Validation rules of the target version whose errors this rule explains.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "fixes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/fixId"
            }
          }
        }
      }
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/fixId"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "pointer": {
      "type": "string",
      "pattern": "^(/([^~/]|~[01])*)*$"
    },
    "fixId": {
      "type": "string",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    }
  }
}
