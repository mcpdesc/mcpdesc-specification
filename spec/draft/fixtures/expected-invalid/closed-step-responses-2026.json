{
  "$schema": "https://mcpdesc.org/schema/mcp-description/0.9.0-draft.2.json",
  "mcpdesc": "0.9.0",
  "info": {
    "name": "closed-step-responses-2026",
    "version": "1.0.0"
  },
  "protocolVersions": ["2026-07-28"],
  "transports": [
    {
      "type": "stdio",
      "command": "closed-step-responses-2026"
    }
  ],
  "tools": [
    {
      "name": "prepare_release",
      "inputSchema": {
        "type": "object"
      },
      "interactionExamples": {
        "approved": {
          "input": {},
          "steps": [
            {
              "type": "roots",
              "request": {},
              "response": {
                "roots": [
                  { "uri": "file:///workspace/example" }
                ],
                "_meta": { "trace": "r1" }
              }
            },
            {
              "type": "sampling",
              "request": {
                "messages": [
                  {
                    "role": "user",
                    "content": { "type": "text", "text": "Summarize the release plan." }
                  }
                ],
                "maxTokens": 50
              },
              "response": {
                "role": "assistant",
                "content": { "type": "text", "text": "Ready to publish." },
                "model": "example-model",
                "_meta": { "trace": "s1" },
                "acmeTrace": { "id": "a2" }
              }
            },
            {
              "type": "elicitation",
              "request": {
                "mode": "form",
                "message": "Approve this release?",
                "requestedSchema": {
                  "type": "object",
                  "properties": {
                    "approved": { "type": "boolean" }
                  },
                  "required": ["approved"]
                }
              },
              "response": {
                "action": "accept",
                "content": { "approved": true },
                "_meta": { "trace": "e1" }
              }
            }
          ],
          "result": {
            "resultType": "complete",
            "content": [
              { "type": "text", "text": "Release prepared." }
            ]
          }
        }
      }
    }
  ]
}
