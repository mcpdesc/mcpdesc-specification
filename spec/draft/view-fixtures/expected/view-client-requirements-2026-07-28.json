{
  "$schema": "https://mcpdesc.org/schema/mcp-description/0.9.0-draft.4.json",
  "mcpdesc": "0.9.0",
  "info": {
    "name": "client-capability-requirements",
    "version": "1.0.0"
  },
  "protocolVersions": [
    "2026-07-28"
  ],
  "capabilities": [
    {
      "extensions": {
        "io.modelcontextprotocol/ui": {}
      }
    }
  ],
  "tools": [
    {
      "name": "rebuild",
