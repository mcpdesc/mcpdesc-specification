      "clientRequirements": {
        "extensions": {
          "io.modelcontextprotocol/tasks": {},
          "io.modelcontextprotocol/ui": {
            "mimeTypes": [
              "text/html;profile=mcp-app"
            ]
          }
        }
      }
    }
  ],
  "resourceTemplates": [
    {
      "uriTemplate": "workspace://{path}",
      "name": "workspace_file",
      "clientRequirements": {
        "elicitation": {
          "form": {}
        }
      }
    }
  ]
}
