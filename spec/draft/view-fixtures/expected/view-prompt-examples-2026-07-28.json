{
  "$schema": "https://mcpdesc.org/schema/mcp-description/0.9.0-draft.3.json",
  "mcpdesc": "0.9.0",
  "info": {
    "name": "prompt-example-fixture",
    "version": "1.0.0"
  },
  "protocolVersions": [
    "2026-07-28"
  ],
  "components": {
    "promptExamples": {
      "default-greeting": {
        "arguments": {},
        "result": {
          "resultType": "complete",
          "messages": [
            {
              "role": "assistant",
              "content": {
                "type": "text",
                "text": "Hello."
              }
            }
          ]
        }
      }
    }
  },
  "prompts": [
    {
      "name": "greeting",
      "examples": {
        "default": {
          "$componentRef": "#/components/promptExamples/default-greeting"
        }
      }
    },
    {
      "name": "city_briefing",
      "arguments": [
        {
          "name": "city",
          "required": true
        },
        {
          "name": "audience"
        }
      ],
      "examples": {
        "paris-engineering": {
          "arguments": {
            "city": "Paris",
            "audience": "engineering"
          },
          "result": {
            "resultType": "complete",
            "description": "Engineering briefing for Paris",
            "messages": [
              {
                "role": "user",
                "content": {
                  "type": "text",
                  "text": "Summarize current engineering considerations for Paris."
                }
              },
              {
                "role": "assistant",
                "content": {
                  "type": "resource_link",
                  "uri": "briefing://paris/engineering",
                  "name": "Paris engineering briefing",
                  "mimeType": "text/markdown"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
